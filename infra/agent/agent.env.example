# Copy to /etc/vps-agent/agent.env and set file mode 0600.
# Paths and identifiers only; certificates/keys are provisioned out-of-band.
VPS_AGENT_HOST_ID=node-01
VPS_AGENT_BIND=127.0.0.1
VPS_AGENT_PORT=9443
VPS_AGENT_TLS_CERT=/etc/vps-agent/server.crt
VPS_AGENT_TLS_KEY=/etc/vps-agent/server.key
VPS_AGENT_CLIENT_CA=/etc/vps-agent/control-plane-ca.crt
VPS_AGENT_CONTROLLER_CN=control-plane
VPS_AGENT_STATE_PATH=/var/lib/vps-agent/agent.sqlite3
VPS_AGENT_LIBVIRT_URI=qemu:///system
VPS_AGENT_STORAGE_POOL=vps-agent-pool
VPS_AGENT_STORAGE_PATH=/var/lib/libvirt/images/vps-agent-pool
VPS_AGENT_IMAGE_PATH=/usr/local/share/vps-cloud-images
VPS_AGENT_PRIVATE_NETWORK=vps-private
VPS_AGENT_PRIVATE_CIDR=10.240.0.0/24
VPS_AGENT_PRIVATE_GATEWAY=10.240.0.1
VPS_AGENT_DHCP_START=10.240.0.10
VPS_AGENT_DHCP_END=10.240.0.250
VPS_AGENT_PRIVATE_BRIDGE=virbr-vps
# false by default; true allows provision requests to create/start this exact private NAT network.
VPS_AGENT_ALLOW_NETWORK_CREATE=false
VPS_AGENT_RESERVE_CPU=1
VPS_AGENT_RESERVE_MEMORY_MIB=2048
VPS_AGENT_MAX_VCPUS=16
VPS_AGENT_MAX_MEMORY_MIB=65536
VPS_AGENT_MAX_DISK_GIB=1024
VPS_AGENT_COMMAND_TIMEOUT=30
